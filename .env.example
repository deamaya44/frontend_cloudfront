# Lambda Function URLs
# Reemplaza estos valores con tus URLs reales de Lambda

# Lambda en us-east-1 (Región primaria)
LAMBDA_URL_PRIMARY=https://your-lambda-url-region1.lambda-url.us-east-1.on.aws

# Lambda en us-west-2 (Región secundaria - failover)
LAMBDA_URL_SECONDARY=https://your-lambda-url-region2.lambda-url.us-west-2.on.aws
